# .dev.vars.example — committed template. Copy to .dev.vars and fill real values.
#   cp .dev.vars.example .dev.vars
# .dev.vars is gitignored; wrangler dev auto-loads it. Never commit real values.
# Format is dotenv (KEY=value); quotes optional but safe for tokens.

# GitHub personal-access / installation token used to read the private repo.
PRIVATE_REPO_TOKEN="ghp_replace_me"

# GitHub OAuth App client secret (paired with your OAuth client ID).
GITHUB_OAUTH_CLIENT_SECRET="replace_me"

# PostHog project key for server-side capture (ticket 06 / ADR-0010). The same
# write-only key the browser bundle carries — kept out of the repo, not out of
# the browser. Leave unset locally and capture is a silent no-op.
POSTHOG_PROJECT_KEY="phc_replace_me"

# PostHog PERSONAL API key with the `person:write` scope (ticket 09), from
# https://us.posthog.com/settings/user-api-keys. This one really is privileged:
# it is what deletes a person during account erasure, which the project key above
# cannot do. Unset means POST /account/delete fails instead of half-deleting.
POSTHOG_PERSONAL_API_KEY="phx_replace_me"
