# Production build env. NEXT_PUBLIC_* is inlined into the client bundle at `next build`
# time, so the deployed catalog table/tiles fetch the live backend — NOT the localhost:8787
# dev fallback in lib/api.ts. Public value (a public read-only API URL), safe to commit —
# and this file IS tracked: `.gitignore` ignores `.env*` but negates this one. Nothing
# private goes in here; a var added below is committed and shipped to the browser.
NEXT_PUBLIC_CATALOG_API_URL=https://api.graflet.rnui.dev

# PostHog (ADR-0010). The key is a *public* project token — it only permits writes,
# which is why it ships in the client bundle by design. Project `graflet` (id 528914),
# US region. HOST is the managed reverse proxy at edge.graflet.rnui.dev, NOT
# us.i.posthog.com: ad blockers block the posthog.com hosts, and this recovers 10-30%
# of events. If the proxy ever breaks, point HOST at https://us.i.posthog.com to
# restore capture (losing the blocked share) rather than losing analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=phc_B2JMYrZWSYybsTw4RmYNmTLKtgqPBZDLzq4jGp5GK5Ex
NEXT_PUBLIC_POSTHOG_HOST=https://edge.graflet.rnui.dev
